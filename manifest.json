{
  "name": "JEE2027 Hub — All-in-One Prep OS",
  "short_name": "JEE HUB",
  "description": "JEE2027 Hub - Your ultimate preparation partner for JEE exams with test series and notes.",
  "id": "com.jeehub.app",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#06060f",
  "theme_color": "#0a0a18",
  "categories": ["education", "books"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "logo.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "logo.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "logo.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "logo.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "logo.png", "sizes": "192x192", "type": "image/png", "form_factor": "narrow", "label": "Mobile" },
    { "src": "logo.png", "sizes": "192x192", "type": "image/png", "form_factor": "wide", "label": "Desktop" }
  ],
  "shortcuts": [
    {
      "name": "Open Test Series",
      "short_name": "Tests",
      "url": "./index.html",
      "icons": [{ "src": "logo.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "widgets": [
    {
      "name": "JEE Hub Quiz",
      "short_name": "Quiz",
      "description": "Daily Quiz Widget",
      "tag": "jee-quiz",
      "ms_ac_template": "./index.html",
      "data": "./index.html",
      "type": "text/html",
      "icons": [{ "src": "logo.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": { "image/*": [".jpg", ".png"] },
      "icons": [{ "src": "logo.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "protocol_handlers": [
    { "protocol": "web+jeehub", "url": "./index.html?type=%s" }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "display_override": ["window-controls-overlay", "minimal-ui"],
  "edge_side_panel": { "preferred_width": 480 },
  "note_taking": { "new_note_url": "./index.html?note=new" },
  "handle_links": "auto",
  "tabbed_display": "standalone"
}
